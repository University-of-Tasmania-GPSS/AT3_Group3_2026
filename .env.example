# Copy to .env and set to your local OneDrive data folder.
# Mac example:
# AT3_DATA_DIR="/Users/you/Library/CloudStorage/OneDrive-SharedLibraries-UniversityofTasmania/Rachel Roberts - AT3_initial_datasets"
# Windows example:
# AT3_DATA_DIR="C:/Users/innoc/OneDrive - University of Tasmania/AT3_initial_datasets"
AT3_DATA_DIR="/path/to/your/OneDrive/AT3_info"
